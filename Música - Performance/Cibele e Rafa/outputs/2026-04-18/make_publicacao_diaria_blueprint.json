    {
      "id": 3,
      "module": "code:runCode",
      "version": 1,
      "mapper": {
        "language": "javascript",
        "inputFormat": "codeEditor",
        "code": "const rows = Array.isArray(input.eligible_rows) ? input.eligible_rows : []; const stateRows = Array.isArray(input.cycle_state) ? input.cycle_state : (input.cycle_state ? [input.cycle_state] : []); const state = stateRows[0] || {}; const keyOf = (row) => row.video_id || row.id || row['0'] || ''; const copy = (value) => JSON.parse(JSON.stringify(value || {})); const pool = rows.map((row) => copy(row)); if (!pool.length) throw new Error('No eligible rows found in publicacao_diaria.'); let order = []; if (state.cycle_order_json) { try { order = JSON.parse(state.cycle_order_json); } catch (e) { order = []; } } if (!Array.isArray(order) || !order.length) { order = pool.map(keyOf).sort(() => Math.random() - 0.5); } let position = Number(state.cycle_position || 0); if (position >= order.length) { order = pool.map(keyOf).sort(() => Math.random() - 0.5); position = 0; } let selectedId = order[position]; let selectedRow = pool.find((row) => keyOf(row) === selectedId); if (!selectedRow) { selectedRow = pool[0]; selectedId = keyOf(selectedRow); position = 0; } const cycleId = state.cycle_id || ('cycle_' + Date.now()); return { selected_row: selectedRow, cycle_state: { state_id: state.state_id || 'cycle_state', cycle_id: cycleId, cycle_order_json: JSON.stringify(order), cycle_position: position + 1, last_video_id: keyOf(selectedRow), last_run_at: new Date().toISOString() } };",
        "input": {
          "eligible_rows": "{{2}}",
          "cycle_state": "{{1}}"
        }
      },
